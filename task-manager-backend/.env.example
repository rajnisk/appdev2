# Copy to .env and fill in values. Never commit .env.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-jwt

# SQLite (default) or postgres URL
DATABASE_URL=sqlite:///taskmanager.db

# Default admin (created automatically if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Required for admin emails (report button + monthly report)
ADMIN_EMAIL=you@gmail.com

# Gmail SMTP — use an App Password: https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=you@gmail.com

# Redis (Celery broker + cache)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CACHE_TYPE=RedisCache

# Celery Beat schedule (UTC by default)
CELERY_TIMEZONE=UTC
DAILY_REMINDER_HOUR=9
DAILY_REMINDER_MINUTE=0
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=8
MONTHLY_REPORT_MINUTE=0

PORT=5000
